{
  "name": "nyuchi-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Nyuchi Maps: the Nyuchi platform base-map service, a Cloudflare Worker serving PMTiles from R2",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:web && wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:install": "npm ci --prefix site",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/build-web.mjs --check"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "hono": "^4.13.12",
    "pmtiles": "4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "maplibre-gl": "6.19.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "sharp@<0.35.4": "^0.35.4",
    "undici@<7.30.2": "^7.30.2",
    "zod@<4.6.7": "^4.6.7",
    "sharp": "^0.35.5"
  }
}
