---
import Shell from "../layouts/Shell.astro";
import PageHeader from "@bundu/ui/app/PageHeader.astro";
import StatTiles from "@bundu/ui/app/StatTiles.astro";
import StatTile from "@bundu/ui/app/StatTile.astro";
import DataTable from "@bundu/ui/app/DataTable.astro";
import Card from "@bundu/ui/app/Card.astro";
import Badge from "@bundu/ui/app/Badge.astro";
import Sample from "../components/Sample.astro";
import { BASE } from "../lib";
const rows = [
  { cell: { text: "6/50/31", mono: true }, state: { text: "Ready", tone: "success" }, build: { text: "20261127" }, size: { text: "99 MB" }, when: { text: "28 Nov, 10:00" } },
  { cell: { text: "6/51/31", mono: true }, state: { text: "Building", tone: "info" }, build: { text: "20261127" }, size: { text: "—" }, when: { text: "28 Nov, 11:20" } },
  { cell: { text: "6/52/30", mono: true }, state: { text: "Pending", tone: "warning" }, build: { text: "—" }, size: { text: "—" }, when: { text: "28 Nov, 11:41" } },
  { cell: { text: "6/47/34", mono: true }, state: { text: "Ready", tone: "success" }, build: { text: "20261120" }, size: { text: "212 MB" }, when: { text: "21 Nov, 09:12" } },
  { cell: { text: "6/20/40", mono: true }, state: { text: "Observed", tone: "neutral" }, build: { text: "—" }, size: { text: "—" }, when: { text: "27 Nov, 17:03" } },
];
---
<Shell title="Coverage" current="/coverage/">
  <PageHeader title="Coverage" description="Where the map is stored, and the regions people have asked for that are still being built." docsHref="https://docs.nyuchi.com" crumbs={[{ label: "Console", href: "#" }, { label: "Maps", href: "/" }, { label: "Coverage" }]} />
  <Sample />
  <StatTiles label="Coverage" columns={4}>
    <StatTile label="Stored cells" value={4420} note="z6 cells in the main archive" />
    <StatTile label="On-demand regions" value={14} note="Ready to serve" />
    <StatTile label="Waiting" value={3} note="Pending or building" />
    <StatTile label="Needs attention" value={0} note="Failed builds" />
  </StatTiles>
  <div class="grid gap-[14px]">
    <div id="cov-map" class="maps-frame h-[360px] xl:h-[420px]" data-map data-base={BASE} data-style="auto" data-center="62,2" data-zoom="1.7" data-coverage="/data/extract-regions.geojson" role="region" aria-label="The areas stored in the main archive, outlined"></div>
    <p class="text-body-sm text-muted-foreground">The outlined areas are stored in the main archive. A place outside them is requested when people look at it, and built in the background.</p>
  </div>
  <DataTable caption="On-demand regions" columns={[{ key: "cell", label: "Cell" }, { key: "state", label: "State" }, { key: "build", label: "Build" }, { key: "size", label: "Size" }, { key: "when", label: "Updated" }]} rows={rows} rowKey="cell" />
</Shell>
