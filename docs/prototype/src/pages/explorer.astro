---
import Shell from "../layouts/Shell.astro";
import PageHeader from "@bundu/ui/app/PageHeader.astro";
import Card from "@bundu/ui/app/Card.astro";
import Button from "@bundu/ui/app/Button.astro";
import Badge from "@bundu/ui/app/Badge.astro";
import SegmentedControl from "@bundu/ui/SegmentedControl.astro";
import DetailPanel from "@bundu/ui/app/DetailPanel.astro";
import Copy from "../components/Copy.astro";
import Sample from "../components/Sample.astro";
import { BASE, HOST } from "../lib";
---
<Shell title="Explorer" current="/explorer/">
  <PageHeader title="Explorer" description="Our base map, drawn from our own tiles. Switch the style, move around, and copy the URL a developer would use." docsHref="https://docs.nyuchi.com" crumbs={[{ label: "Console", href: "#" }, { label: "Maps", href: "/" }, { label: "Explorer" }]} />
  <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_21rem]">
    <div class="grid gap-[14px]">
      <div class="flex flex-wrap items-end gap-[14px]">
        <div data-style-group>
          <SegmentedControl name="style" legend="Style" size="sm" value="auto" options={[["light", "Light"], ["dark", "Dark"]]} />
        </div>
        <Copy text={`${HOST}/v1/styles/light.json`} label="Copy style URL" />
      </div>
      <div id="explorer-map" class="maps-frame h-[56vh] min-h-[340px] xl:h-[620px]" data-map data-base={BASE} data-style="auto" data-center="31,-1.5" data-zoom="3.1" data-readout="#readout" role="region" aria-label="Map of Africa and South East Asia, drawn from Nyuchi tiles"></div>
      <p class="text-body-sm text-muted-foreground">Credits come from the tile source and are always shown on the map: © OpenStreetMap contributors.</p>
    </div>
    <div class="grid content-start gap-5">
      <Card padding="md">
        <h2 class="text-body font-semibold">View</h2>
        <dl class="mt-3 grid gap-[14px] text-body-sm">
          <div><dt class="text-muted-foreground">Centre and zoom</dt><dd id="readout" class="font-mono">loading…</dd></div>
          <div><dt class="text-muted-foreground">Tile source</dt><dd class="flex flex-wrap items-center gap-2"><span class="font-mono">basemap</span><Badge variant="secondary">vector · MVT</Badge></dd></div>
          <div><dt class="text-muted-foreground">Zoom range</dt><dd>0 to 14</dd></div>
          <div><dt class="text-muted-foreground">Style URL</dt><dd class="font-mono break-all">{HOST}/v1/styles/light.json</dd></div>
        </dl>
      </Card>
      <Card padding="md">
        <h2 class="text-body font-semibold">Use this map</h2>
        <p class="mt-2 text-body-sm text-muted-foreground">Copy the style into your own application, or build an embed.</p>
        <div class="mt-3 flex flex-wrap gap-[9px]">
          <Button href="/embed/" variant="primary">Build an embed</Button>
          <Button href="/endpoints/" variant="outline">See endpoints</Button>
        </div>
      </Card>
    </div>
  </div>
  <script is:inline>
    document.querySelectorAll('[data-style-group] input[type=radio]').forEach((i) => {
      i.dataset.styleFor = '#explorer-map';
      if (i.value === (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) i.checked = true;
    });
  </script>
</Shell>
