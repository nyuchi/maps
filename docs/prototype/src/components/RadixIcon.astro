---
/**
 * The icon seam. Mzizi's docs name Lucide as the library and `lib/icons` as the one place to
 * swap it (the "swappable" strand); the owner's icon set is Radix. This component has the
 * props of @bundu/ui's Icon (name, title, class) and draws the Radix icon that stands in for
 * each Mzizi icon name (src/radix.ts, generated by scripts/gen-radix.mjs). astro.config.mjs
 * points every `Icon.astro` import, inside @bundu/ui too, at this file.
 */
import { RADIX } from "../radix";
const { name, title, class: className } = Astro.props;
const decorative = !title;
const inner = RADIX[name] ?? RADIX.more;
---
<svg
  class={["inline-block h-[1em] w-[1em]", className].filter(Boolean).join(" ")}
  viewBox="0 0 15 15"
  fill="none"
  data-slot="icon"
  data-icon={name}
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : title}
  set:html={(title ? `<title>${title}</title>` : "") + inner}
/>
