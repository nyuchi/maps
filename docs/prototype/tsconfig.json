{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    // astro.config.mjs aliases this to the Cloudflare transport for the
    // Worker build; the types are the same.
    "paths": {
      "@console/backend-transport": ["./src/lib/transport.node.ts"]
    }
  }
}
