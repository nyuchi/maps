/**
 * Nyuchi Maps: the Nyuchi platform base-map service.
 *
 * A thin Worker over ONE R2 bucket holding a PMTiles archive, glyph PBFs and
 * sprites. Nothing here is created by this file: the bucket, the DNS record
 * and the route are the owner's to provision. See docs/ARCHITECTURE.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyuchi-maps",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // No *.workers.dev URL and no per-version preview URLs: the Worker is
  // reachable only through the route below, once the owner enables it.
  "workers_dev": false,
  "preview_urls": false,

  // openapi/openapi.yaml is imported as text and served at /openapi.json.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],

  // The map page (GET /) and its assets: public/ is built by
  // scripts/build-web.mjs (`npm run build:web`) and committed. The Worker
  // runs first for every request, so /v1 is untouched and src/web.ts adds the
  // security and cache headers; it reaches the files through ASSETS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  // maps.nyuchi.com is served by this Worker as a Cloudflare custom domain:
  // a deploy creates the DNS record and the certificate. The map page is live
  // at / and the API under /v1 from the first deploy that carries this route.
  "routes": [{ "pattern": "maps.nyuchi.com", "custom_domain": true }],

  "vars": {
    // Public origin used in TileJSON and style URLs, without a trailing
    // slash. maps.nyuchi.com is the owner-confirmed host. When this is unset
    // or invalid the Worker falls back to the origin of the request.
    "PUBLIC_BASE_URL": "https://maps.nyuchi.com",
    // Comma-separated first-party origins allowed by CORS. A leading
    // "*." label after the scheme matches any subdomain. Production only:
    // for local development put ALLOWED_ORIGINS (with http://localhost:3000)
    // in .dev.vars, see .dev.vars.example.
    "ALLOWED_ORIGINS": "https://weather.mukoko.com,https://weatherstations.nyuchi.com",
    // Origin auth for /v1: "off" (today's behaviour), "log" (verify and
    // count, never reject) or "enforce" (401 without a valid signature from
    // the Nyuchi Servers API). The verification keys are the Worker secret
    // ORIGIN_AUTH_KEYS ("kid:secret,kid:secret"), set with `wrangler secret
    // put`, never here. See docs/ARCHITECTURE.md, "Origin authentication".
    "ORIGIN_AUTH": "off",
    // On-demand map regions: a tile the archive does not hold records demand;
    // the region builder (on Coolify) builds the region and the Worker serves
    // it once the manifest lists it. "off" or unset restores the old behaviour.
    "ONDEMAND_REGIONS": "on",
    // Object key of the PMTiles archive inside the bucket.
    "TILES_KEY": "tiles/nyuchi-maps.pmtiles",
    // Part of the edge cache key. Bump it (and deploy) whenever the archive
    // object is replaced, so tiles cached from the old archive are retired.
    "TILES_VERSION": "2",
  },

  // The binding NAME is what the code uses. The bucket holds the PMTiles
  // archive (tiles/), glyph PBFs (fonts/) and sprites (sprites/); see
  // scripts/build-extract.md for how they are produced and uploaded.
  "r2_buckets": [
    {
      "binding": "MAPS_BUCKET",
      "bucket_name": "nyuchi-maps",
    },
  ],

  // Per-IP limit on /v1 routes; tiles are counted only on an edge-cache miss.
  // namespace_id is ours to choose but must be unique in the Cloudflare
  // account, and is not a resource to create first. 1001 is the Mukoko API's
  // IP limiter, so this Worker uses 7402. Check it is free before deploying.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "7402",
      "simple": { "limit": 1800, "period": 60 },
    },
  ],

  // On-demand regions (docs/ondemand-regions.md). The demand ledger is a
  // SQLite-backed Durable Object; the class is exported by src/index.ts and
  // the migration below is applied by the deploy itself, so nothing has to be
  // created first. It is idle until the owner sets the var
  // ONDEMAND_REGIONS=on (add it to "vars" when enabling; unset means off and
  // the Worker behaves exactly as before) and the BUILDER_TOKEN secret.
  "durable_objects": {
    "bindings": [{ "name": "DEMAND", "class_name": "DemandLedger" }],
  },
  "migrations": [
    { "tag": "v1-demand-ledger", "new_sqlite_classes": ["DemandLedger"] },
  ],

  "observability": {
    "enabled": true,
  },
}
