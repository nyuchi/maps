---
import Alert from "@bundu/ui/app/Alert.astro";
import Badge from "@bundu/ui/app/Badge.astro";
import Card from "@bundu/ui/app/Card.astro";
import FormField from "@bundu/ui/app/FormField.astro";
import PageHeader from "@bundu/ui/app/PageHeader.astro";
import Copy from "../components/Copy.astro";
import Shell from "../layouts/Shell.astro";
import elementUrl from "../scripts/nyuchi-map.js?url";
import { CONSOLE_KEYS_URL, SITE_ORIGIN } from "../config";
---
<Shell
  title="Embed builder"
  current="/embed-builder/"
  description="Put a Nyuchi map on a web page: choose how it looks, check it, copy the code."
>
  <PageHeader
    title="Embed builder"
    description="Choose how the map looks, check it in the preview, and copy the iframe or script snippet."
    docsHref="/docs/"
  />

  <Alert variant="info" title="Keys arrive with the API">
    <p>There is no key in these snippets because there are no Maps keys yet. Until the Maps API is enabled, the embed page may be framed only by this site and by the sites listed below. Per-key lists of allowed sites arrive with the API and are managed in the <a class="underline underline-offset-4" href={CONSOLE_KEYS_URL}>Nyuchi Console</a>.</p>
  </Alert>

  <div class="grid gap-5 xl:grid-cols-[minmax(0,22rem)_minmax(0,1fr)]">
    <Card padding="md" class="content-start">
      <form id="embed-form" class="grid gap-[14px]" data-site={SITE_ORIGIN} data-element={elementUrl} autocomplete="off">
        <FormField name="style" label="Style" as="radio-group" value="light" options={[{ value: "light", label: "Light" }, { value: "dark", label: "Dark" }]} />
        <div class="grid grid-cols-2 gap-[9px]">
          <FormField name="lat" label="Latitude" type="number" step="0.0001" min="-85" max="85" value="-17.83" />
          <FormField name="lng" label="Longitude" type="number" step="0.0001" min="-180" max="180" value="31.05" />
        </div>
        <FormField name="zoom" label="Zoom" type="number" min="0" max="22" step="0.5" value="11" hint="0 is the whole world, 14 is a street." />
        <FormField name="markers" label="Markers" as="textarea" rows={3} value="" hint="One per line: longitude,latitude. At most 50." />
        <p id="markers-note" class="text-body-sm text-muted-foreground" role="status"></p>
        <FormField name="label" label="Description of the map" value="Map of Harare" maxlength={100} hint="Read out by screen readers and used as the frame's title." />
        <FormField name="height" label="Height in pixels" type="number" min="120" max="2000" step="10" value="400" />
        <FormField name="controls" label="Zoom controls" as="switch" checked={true} />
      </form>
    </Card>

    <div class="grid min-w-0 content-start gap-5">
      <div class="grid gap-[14px]">
        <iframe id="preview" class="maps-embed-frame" title="Preview of the embedded map" loading="eager" src="/embed/?style=light&center=31.05,-17.83&zoom=11"></iframe>
        <p class="flex flex-wrap items-center gap-[14px] text-body-sm text-muted-foreground">
          <Badge variant="secondary">Credits always on</Badge>
          The credit is part of the map. It comes from the TileJSON and there is no setting to hide it.
        </p>
      </div>

      <Card padding="md" class="grid gap-[14px]">
        <h2 class="text-body font-semibold">Who may frame the embed page today</h2>
        <ul id="ancestors" role="list" class="flex flex-wrap gap-[14px]"><li>Reading the service's policy…</li></ul>
        <p class="text-body-sm text-muted-foreground">This list is what the service sends in its <code class="font-mono">frame-ancestors</code> policy right now, read from the embed page itself. A site that is not on it cannot show the embed, however the snippet is written.</p>
      </Card>

      <Card padding="md" class="grid gap-[14px]">
        <h2 class="text-body font-semibold">Copy the code</h2>
        <details class="maps-snip" name="embed" open>
          <summary class="inline-flex h-8 items-center rounded-full bg-muted px-4 text-body-sm font-medium pointer-coarse:h-11">Iframe</summary>
          <div class="mt-3">
            <div class="maps-code" data-lang="html">
              <Copy from="iframe-code" about="iframe snippet" />
              <pre tabindex="0" aria-label="Iframe snippet"><code id="iframe-code">Building the snippet…</code></pre>
            </div>
          </div>
        </details>
        <details class="maps-snip" name="embed">
          <summary class="inline-flex h-8 items-center rounded-full bg-muted px-4 text-body-sm font-medium pointer-coarse:h-11">Script</summary>
          <div class="mt-3">
            <div class="maps-code" data-lang="html">
              <Copy from="script-code" about="script snippet" />
              <pre tabindex="0" aria-label="Script snippet"><code id="script-code">Building the snippet…</code></pre>
            </div>
          </div>
        </details>
        <p class="text-body-sm text-muted-foreground">The script defines a <code class="font-mono">&lt;nyuchi-map&gt;</code> element that builds the same iframe, so the same rule applies. Its address carries a content hash and the snippet pins the exact file with a subresource-integrity hash, computed here from the file served now.</p>
      </Card>
    </div>
  </div>
</Shell>

<script>
  import "../scripts/builder.js";
</script>
