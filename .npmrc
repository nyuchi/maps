# Needed: without it npm's resolver crashes ("Cannot read properties of null
# (reading 'edgesOut')") on the sharp/undici overrides in package.json, because
# @cloudflare/vitest-pool-workers declares peers it cannot satisfy exactly.
# Remove once that package's peer ranges and the overrides line up.
legacy-peer-deps=true
# Wait a week before resolving newly published versions (npm 11.10+).
min-release-age=7
